rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Images and devlog assets: public read, authenticated upload
    match /images/{imageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /covers/{coverId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
